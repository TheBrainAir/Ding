# Copy to backend/.env and fill in. Never commit .env: this repo is public.

# Required: the waiter's brain (Claude). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: speech in and out (ElevenLabs Scribe + TTS). Without it the app runs in
# text mode: typed turns work, voice_enabled is false, /api/voices returns [].
# Restart the backend after adding it.
ELEVENLABS_API_KEY=

# Optional overrides
# DING_DATA_DIR=./data                    # SQLite file + uploaded photos (media/)
# DING_MODEL_CACHE=./data/models          # embedding model weights (~1.1 GB, downloaded on first start)
# DING_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
